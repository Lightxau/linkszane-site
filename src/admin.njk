---
layout: base.njk
title: "Admin — LinksZane"
description: "Manage LinksZane videos."
hideAds: true
---

<div id="login-section">
  <h1 class="watch-title">Admin Login</h1>
  <p class="modal-error" id="login-error" style="display:none;"></p>
  <input type="email" id="email-input" placeholder="Email" style="width:100%;margin-bottom:10px;padding:12px;background:transparent;border:1px solid var(--line);border-radius:6px;color:var(--paper);">
  <input type="password" id="password-input" placeholder="Password" style="width:100%;margin-bottom:10px;padding:12px;background:transparent;border:1px solid var(--line);border-radius:6px;color:var(--paper);">
  <button id="login-btn" style="background:var(--amber);color:var(--ink);border:none;border-radius:6px;padding:12px 22px;font-weight:600;cursor:pointer;">Log in</button>
</div>

<div id="manage-section" style="display:none;">
  <div class="admin-bar open">
    <span>● Logged in</span>
    <button id="logout-btn">Log out</button>
  </div>

  <form id="add-form" class="open">
    <input id="url-input" type="text" placeholder="Video URL (YouTube, Vimeo, Cloudinary, Backblaze, .mp4)" required>
    <input id="title-input" type="text" placeholder="Title">
    <input id="tags-input" type="text" placeholder="Tags, comma separated">
    <input id="duration-input" type="text" placeholder="Duration (e.g. 12:34 or 1:02:15)">
    <input id="download-input" type="text" placeholder="Download link (optional)">
    <input id="thumbnail-input" type="text" placeholder="Thumbnail image URL (optional — for Backblaze/mp4 links)">
    <label style="display:block;margin:6px 0 2px;font-size:13px;color:var(--paper);opacity:.8;">Or upload a thumbnail from your gallery:</label>
    <input id="thumbnail-file" type="file" accept="image/*" style="width:100%;margin-bottom:10px;">
    <button type="submit">Add video</button>
  </form>
  <p class="error" id="form-error"></p>
  <p id="rebuild-msg" style="display:none;color:var(--amber);font-family:'JetBrains Mono',monospace;font-size:13px;"></p>

  <p class="section-title">Existing videos</p>
  <div id="video-list"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
(function(){
  var SUPABASE_URL = "https://owuchppfijermqpuggfh.supabase.co";
  var SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im93dWNocHBmaWplcm1xcHVnZ2ZoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIxOTgzNDMsImV4cCI6MjA5Nzc3NDM0M30._sp1ITPTxTjghaZLEGlxZCV203XNxVjWA4nirYMN_iU";
  var TABLE = "linkszane_videos";
  var BUILD_HOOK_URL = "https://api.cloudflare.com/client/v4/workers/builds/deploy_hooks/ac6664db-0fde-4f9e-9b1d-29c52b1fab49";

  var supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
    auth: { persistSession: false, autoRefreshToken: false }
  });

  var loginSection = document.getElementById('login-section');
  var manageSection = document.getElementById('manage-section');
  var loginError = document.getElementById('login-error');
  var emailInput = document.getElementById('email-input');
  var passwordInput = document.getElementById('password-input');
  var loginBtn = document.getElementById('login-btn');
  var logoutBtn = document.getElementById('logout-btn');
  var form = document.getElementById('add-form');
  var urlInput = document.getElementById('url-input');
  var titleInput = document.getElementById('title-input');
  var tagsInput = document.getElementById('tags-input');
  var durationInput = document.getElementById('duration-input');
  var downloadInput = document.getElementById('download-input');
  var thumbnailInput = document.getElementById('thumbnail-input');
  var thumbnailFile = document.getElementById('thumbnail-file');
  var formError = document.getElementById('form-error');
  var rebuildMsg = document.getElementById('rebuild-msg');
  var videoList = document.getElementById('video-list');

  loginBtn.addEventListener('click', async function(){
    loginError.style.display = 'none';
    try {
      var res = await supabase.auth.signInWithPassword({ email: emailInput.value.trim(), password: passwordInput.value });
      if (res.error) throw res.error;
      loginSection.style.display = 'none';
      manageSection.style.display = 'block';
      loadVideos();
    } catch(e) {
      loginError.textContent = 'Wrong email or password.';
      loginError.style.display = 'block';
    }
  });

  logoutBtn.addEventListener('click', async function(){
    await supabase.auth.signOut();
    manageSection.style.display = 'none';
    loginSection.style.display = 'block';
  });

  function parseVideo(url){
    url = (url || '').trim();
    var m;
    m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/shorts\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{6,})/);
    if(m) return { type:'iframe', src:'https://www.youtube.com/embed/' + m[1] };
    m = url.match(/vimeo\.com\/(?:video\/)?(\d+)/);
    if(m) return { type:'iframe', src:'https://player.vimeo.com/video/' + m[1] };
    m = url.match(/customer-([a-z0-9]+)\.cloudflarestream\.com\/([a-zA-Z0-9]+)/i);
    if(m) return { type:'iframe', src:'https://customer-' + m[1] + '.cloudflarestream.com/' + m[2] + '/iframe' };
    if(/res\.cloudinary\.com\/.+\/video\/upload\//i.test(url)) return { type:'video', src:url };
    if(/backblazeb2\.com\/file\//i.test(url)) return { type:'video', src:url };
    if(/\.(mp4|webm|ogg)(\?.*)?$/i.test(url)) return { type:'video', src:url };
    if(/^https?:\/\//i.test(url)) return { type:'iframe', src:url };
    return null;
  }

  async function saveEdit(v, fields, editWrap, statusEl){
    statusEl.textContent = '';
    var updates = {
      title: fields.title.value.trim() || 'Untitled',
      tags: fields.tags.value.trim(),
      duration: fields.duration.value.trim() || null,
      download_url: fields.download.value.trim() || null
    };

    if (fields.thumbFile.files && fields.thumbFile.files[0]) {
      try {
        statusEl.textContent = 'Uploading thumbnail…';
        updates.thumbnail_url = await uploadThumbnail(fields.thumbFile.files[0], v.id);
      } catch (err) {
        statusEl.textContent = 'Thumbnail upload failed: ' + (err.message || err);
        return;
      }
    } else if (fields.thumbUrl.value.trim()) {
      updates.thumbnail_url = fields.thumbUrl.value.trim();
    }

    statusEl.textContent = 'Saving…';
    var res = await supabase.from(TABLE).update(updates).eq('id', v.id);
    if (res.error) { statusEl.textContent = 'Save failed: ' + res.error.message; return; }
    statusEl.textContent = 'Saved.';
    triggerRebuild();
    loadVideos();
  }

  async function loadVideos(){
    videoList.innerHTML = 'Loading…';
    var res = await supabase.from(TABLE).select('*').order('created_at', { ascending:false });
    if (res.error) { videoList.innerHTML = 'Failed to load videos.'; return; }
    var videos = res.data || [];
    if (videos.length === 0) { videoList.innerHTML = '<div class="empty">No videos yet.</div>'; return; }
    videoList.innerHTML = '';
    videos.forEach(function(v){
      var row = document.createElement('div');
      row.className = 'card';
      row.style.padding = '12px 14px';
      row.style.marginBottom = '10px';
      row.innerHTML = '<div class="card-title">' + (v.title || 'Untitled') + '</div><div class="card-sub"><span>' + (v.views||0) + ' views</span></div>';

      var btnRow = document.createElement('div');
      btnRow.style.display = 'flex';
      btnRow.style.gap = '8px';
      btnRow.style.marginTop = '10px';

      var editBtn = document.createElement('button');
      editBtn.className = 'remove-btn';
      editBtn.textContent = 'Edit';

      var removeBtn = document.createElement('button');
      removeBtn.className = 'remove-btn';
      removeBtn.textContent = 'Remove';

      btnRow.appendChild(editBtn);
      btnRow.appendChild(removeBtn);
      row.appendChild(btnRow);

      var editWrap = document.createElement('div');
      editWrap.style.display = 'none';
      editWrap.style.marginTop = '12px';
      editWrap.style.paddingTop = '12px';
      editWrap.style.borderTop = '1px solid var(--line)';

      var titleField = document.createElement('input');
      titleField.type = 'text'; titleField.placeholder = 'Title';
      titleField.value = v.title || '';
      titleField.style.cssText = 'width:100%;margin-bottom:8px;padding:10px;background:transparent;border:1px solid var(--line);border-radius:6px;color:var(--paper);';

      var tagsField = document.createElement('input');
      tagsField.type = 'text'; tagsField.placeholder = 'Tags, comma separated';
      tagsField.value = v.tags || '';
      tagsField.style.cssText = titleField.style.cssText;

      var durationField = document.createElement('input');
      durationField.type = 'text'; durationField.placeholder = 'Duration (e.g. 12:34)';
      durationField.value = v.duration || '';
      durationField.style.cssText = titleField.style.cssText;

      var downloadField = document.createElement('input');
      downloadField.type = 'text'; downloadField.placeholder = 'Download link (optional)';
      downloadField.value = v.download_url || '';
      downloadField.style.cssText = titleField.style.cssText;

      var thumbUrlField = document.createElement('input');
      thumbUrlField.type = 'text'; thumbUrlField.placeholder = 'Thumbnail image URL';
      thumbUrlField.value = v.thumbnail_url || '';
      thumbUrlField.style.cssText = titleField.style.cssText;

      var thumbLabel = document.createElement('label');
      thumbLabel.textContent = 'Or replace thumbnail from your gallery:';
      thumbLabel.style.cssText = 'display:block;margin:6px 0 2px;font-size:13px;color:var(--paper);opacity:.8;';

      var thumbFileField = document.createElement('input');
      thumbFileField.type = 'file'; thumbFileField.accept = 'image/*';
      thumbFileField.style.cssText = 'width:100%;margin-bottom:10px;';

      var saveBtn = document.createElement('button');
      saveBtn.textContent = 'Save changes';
      saveBtn.type = 'button';

      var cancelBtn = document.createElement('button');
      cancelBtn.className = 'remove-btn';
      cancelBtn.textContent = 'Cancel';
      cancelBtn.style.marginLeft = '8px';

      var statusEl = document.createElement('p');
      statusEl.style.cssText = 'font-size:13px;color:var(--amber);font-family:"JetBrains Mono",monospace;margin-top:8px;';

      editWrap.appendChild(titleField);
      editWrap.appendChild(tagsField);
      editWrap.appendChild(durationField);
      editWrap.appendChild(downloadField);
      editWrap.appendChild(thumbUrlField);
      editWrap.appendChild(thumbLabel);
      editWrap.appendChild(thumbFileField);
      editWrap.appendChild(saveBtn);
      editWrap.appendChild(cancelBtn);
      editWrap.appendChild(statusEl);
      row.appendChild(editWrap);

      editBtn.addEventListener('click', function(){
        editWrap.style.display = editWrap.style.display === 'none' ? 'block' : 'none';
      });
      cancelBtn.addEventListener('click', function(){
        editWrap.style.display = 'none';
      });
      saveBtn.addEventListener('click', function(){
        saveEdit(v, { title: titleField, tags: tagsField, duration: durationField, download: downloadField, thumbUrl: thumbUrlField, thumbFile: thumbFileField }, editWrap, statusEl);
      });

      removeBtn.addEventListener('click', async function(){
        if (v.thumbnail_url) {
          try {
            var parts = v.thumbnail_url.split('/' + THUMB_BUCKET + '/');
            if (parts[1]) await supabase.storage.from(THUMB_BUCKET).remove([parts[1]]);
          } catch (e) { console.error('thumbnail delete failed:', e); }
        }
        await supabase.from(TABLE).delete().eq('id', v.id);
        triggerRebuild();
        loadVideos();
      });
      videoList.appendChild(row);
    });
  }

  function triggerRebuild(){
    if (!BUILD_HOOK_URL || BUILD_HOOK_URL.indexOf('PASTE_YOUR') === 0) return;
    rebuildMsg.style.display = 'block';
    rebuildMsg.textContent = 'Triggering rebuild…';
    fetch(BUILD_HOOK_URL, { method: 'POST' }).then(function(res){
      if (res.ok) {
        rebuildMsg.textContent = 'Rebuild triggered — changes will appear in about a minute…';
      } else {
        rebuildMsg.textContent = 'Rebuild request failed (status ' + res.status + '). Trigger a deploy manually in Cloudflare.';
        console.error('Deploy hook returned status', res.status);
      }
    }).catch(function(err){
      rebuildMsg.textContent = 'Rebuild request failed to send (likely blocked by browser/CORS). Trigger a deploy manually in Cloudflare.';
      console.error('Deploy hook fetch failed:', err);
    });
  }

  var THUMB_BUCKET = 'thumbnails';

  async function uploadThumbnail(file, videoId){
    var ext = (file.name.split('.').pop() || 'jpg').toLowerCase();
    var path = videoId + '.' + ext;
    var res = await supabase.storage.from(THUMB_BUCKET).upload(path, file, { upsert: true });
    if (res.error) throw res.error;
    var pub = supabase.storage.from(THUMB_BUCKET).getPublicUrl(path);
    return pub.data.publicUrl;
  }

  form.addEventListener('submit', async function(e){
    e.preventDefault();
    formError.style.display = 'none';
    var parsed = parseVideo(urlInput.value);
    if (!parsed) { formError.textContent = "Couldn't read that link — check the URL and try again."; formError.style.display = 'block'; return; }

    var videoId = 'v' + Date.now() + Math.random().toString(36).slice(2,7);
    var thumbUrl = thumbnailInput.value.trim() || null;

    if (thumbnailFile.files && thumbnailFile.files[0]) {
      try {
        formError.textContent = 'Uploading thumbnail…';
        formError.style.display = 'block';
        thumbUrl = await uploadThumbnail(thumbnailFile.files[0], videoId);
        formError.style.display = 'none';
      } catch (err) {
        formError.textContent = 'Thumbnail upload failed: ' + (err.message || err);
        formError.style.display = 'block';
        return;
      }
    }

    var video = {
      id: videoId,
      title: titleInput.value.trim() || 'Untitled',
      type: parsed.type, src: parsed.src,
      tags: tagsInput.value.trim(),
      duration: durationInput.value.trim() || null,
      download_url: downloadInput.value.trim() || null,
      thumbnail_url: thumbUrl,
      views: 0
    };
    var res = await supabase.from(TABLE).insert([video]);
    if (res.error) { formError.textContent = 'Save failed: ' + res.error.message; formError.style.display = 'block'; return; }
    urlInput.value=''; titleInput.value=''; tagsInput.value=''; durationInput.value=''; downloadInput.value=''; thumbnailInput.value=''; thumbnailFile.value='';
    triggerRebuild();
    loadVideos();
  });
})();
</script>
