---
layout: base.njk
title: "LinksZane — Watch Videos Online"
description: "LinksZane is a simple video hub — browse, watch, and discover related videos."
pagination:
  data: videos
  size: 20
  alias: pageVideos
---

<p class="section-title">Home</p>

<div class="grid">
  {% for video in pageVideos %}
    <a class="card" href="/watch/{{ video.id }}/">
      <div class="frame-wrap">
        {% set thumb = video.thumbnail_url or (video | thumbnailUrl) %}
        {% if thumb %}
          <img src="{{ thumb }}" alt="{{ video.title or 'Untitled' }}" loading="lazy">
        {% elif video.type == "video" %}
          <video src="{{ video.src }}" muted preload="metadata"></video>
        {% else %}
          <iframe src="{{ video.src }}" loading="lazy"></iframe>
        {% endif %}
        <span class="thumb-badge thumb-badge-views"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 5c-7 0-10 7-10 7s3 7 10 7 10-7 10-7-3-7-10-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg><span data-vid="{{ video.id }}">{{ video.views or 0 }}</span></span>
        {% if video.duration %}<span class="thumb-badge thumb-badge-duration"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>{{ video.duration }}</span>{% endif %}
      </div>
      <div class="card-meta">
        <div class="card-title">{{ video.title or "Untitled" }}</div>
      </div>
    </a>
  {% else %}
    <div class="empty">No videos yet.</div>
  {% endfor %}
</div>

{% if pagination.hrefs.length > 1 %}
<div class="pagination">
  {% for href in pagination.hrefs %}
    <a class="page-btn {% if loop.index0 == pagination.pageNumber %}active{% endif %}" href="{{ href }}">{{ loop.index }}</a>
  {% endfor %}
</div>
{% endif %}
