---
pagination:
  data: videos
  size: 1
  alias: video
permalink: "watch/{{ video.id }}/index.html"
layout: base.njk
eleventyComputed:
  title: "{{ video.title or 'Untitled' }} — LinksZane"
  description: "Watch {{ video.title or 'this video' }} on LinksZane."
  ogType: "video.other"
  ogImage: "{{ video.thumbnail_url or (video | thumbnailUrl) }}"
---

<article class="watch-page">
  {% set thumb = video.thumbnail_url or (video | thumbnailUrl) %}
  {% set uploadDate = video.created_at %}
  {% set contentUrl = "" %}
  {% set embedUrl = "" %}
  {% if video.type == "video" %}
    {% set contentUrl = video.src %}
  {% else %}
    {% set embedUrl = video.src %}
  {% endif %}
  {% set thumbArr = [] %}
  {% if thumb %}
    {% set thumbArr = [thumb] %}
  {% endif %}
  {% set videoJsonLd = {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": video.title or "Untitled",
    "description": "Watch " + (video.title or "this video") + " on LinksZane.",
    "thumbnailUrl": thumbArr,
    "uploadDate": uploadDate,
    "contentUrl": contentUrl,
    "embedUrl": embedUrl,
    "interactionStatistic": {
      "@type": "InteractionCounter",
      "interactionType": "https://schema.org/WatchAction",
      "userInteractionCount": video.views or 0
    }
  } %}
  <script type="application/ld+json">{{ videoJsonLd | json | safe }}</script>

  <div class="watch-frame">
    {% if video.type == "video" %}
      <video src="{{ video.src }}" controls preload="metadata" {% if thumb %}poster="{{ thumb }}"{% endif %}></video>
    {% else %}
      <iframe src="{{ video.src }}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
    {% endif %}
  </div>

  <h1 class="watch-title">{{ video.title or "Untitled" }}</h1>
  <p class="watch-meta"><span id="views-count">{{ video.views or 0 }} views</span></p>

  {% set tags = video.tags | tagList %}
  {% if tags.length %}
  <div class="watch-tags">
    {% for tag in tags %}
      <a class="tag-pill" href="/tag/{{ tag | slugify }}/">{{ tag }}</a>
    {% endfor %}
  </div>
  {% endif %}

  {% if video.download_url %}
  <a class="download-link" href="{{ video.download_url }}" target="_blank" rel="noopener noreferrer nofollow">⬇ Download video</a>
  {% endif %}

  <p class="section-title">More on LinksZane</p>
  <div class="grid">
    {% set related = videos | relatedTo(video, 10) %}
    {% for other in related %}
      <a class="card" href="/watch/{{ other.id }}/">
        <div class="frame-wrap">
          {% set otherThumb = other.thumbnail_url or (other | thumbnailUrl) %}
          {% if otherThumb %}
            <img src="{{ otherThumb }}" alt="{{ other.title or 'Untitled' }}" loading="lazy">
          {% elif other.type == "video" %}
            <video src="{{ other.src }}" muted preload="metadata"></video>
          {% else %}
            <iframe src="{{ other.src }}" loading="lazy"></iframe>
          {% endif %}
          <div class="play-badge"><span>▶</span></div>
        </div>
        <div class="card-meta">
          <div class="card-title">{{ other.title or "Untitled" }}</div>
          <div class="card-sub"><span data-vid="{{ other.id }}">{{ other.views or 0 }} views</span></div>
        </div>
      </a>
    {% else %}
      <div class="empty">No related videos yet.</div>
    {% endfor %}
  </div>

  <p><a class="back-link" href="/">← Back to browsing</a></p>
</article>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
(function(){
  var SUPABASE_URL = "https://owuchppfijermqpuggfh.supabase.co";
  var SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im93dWNocHBmaWplcm1xcHVnZ2ZoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIxOTgzNDMsImV4cCI6MjA5Nzc3NDM0M30._sp1ITPTxTjghaZLEGlxZCV203XNxVjWA4nirYMN_iU";
  var supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
    auth: { persistSession: false, autoRefreshToken: false }
  });
  supabase.rpc('increment_views', { row_id: "{{ video.id }}" }).then(function(res){
    if (res.error) { console.error('increment_views failed:', res.error.message); return; }
    return supabase.from("linkszane_videos").select('views').eq('id', "{{ video.id }}").single();
  }).then(function(res){
    if (res && res.data) {
      var el = document.getElementById('views-count');
      if (el) el.textContent = (res.data.views || 0) + ' views';
    }
  }).catch(function(err){ console.error('view count update failed:', err); });
})();
</script>
