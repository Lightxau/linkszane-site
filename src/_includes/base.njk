<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title or "LinksZane — Watch Videos Online" }}</title>
<meta name="description" content="{{ description or 'LinksZane is a simple video hub — browse, watch, and discover related videos.' }}">
<meta name="robots" content="index, follow">
<link rel="canonical" href="https://linkszane.fun{{ page.url }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="LinksZane">
<meta property="og:title" content="{{ title or 'LinksZane — Watch Videos Online' }}">
<meta property="og:description" content="{{ description or 'LinksZane is a simple video hub.' }}">
<meta property="og:url" content="https://linkszane.fun{{ page.url }}">
{% if ogImage %}<meta property="og:image" content="{{ ogImage }}">{% endif %}
<meta name="theme-color" content="#121214">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
<link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
</head>
<body>

<div class="topbar">
  <button class="menu-btn" id="menu-btn" aria-label="Open menu">⋮</button>
  <a href="/" class="logo"><span class="links">Links</span><span class="zane">Zane</span></a>
</div>

<div class="drawer-overlay" id="drawer-overlay"></div>
<nav class="drawer" id="drawer">
  <div class="drawer-header">
    <div class="logo"><span class="links">Links</span><span class="zane">Zane</span></div>
    <button class="drawer-close" id="drawer-close" aria-label="Close menu">✕</button>
  </div>
  <div class="drawer-scroll">
    <a class="drawer-item" href="/">Home</a>
    <a class="drawer-item" href="/search/">Search</a>
    <a class="drawer-item" href="/new/">New</a>
    <button class="drawer-item" id="cat-toggle">
      <span>Categories</span>
      <span class="chevron" id="cat-chevron">›</span>
    </button>
    <div class="drawer-sub" id="cat-sub">
      <a class="drawer-item" href="/latest/">Latest</a>
      <a class="drawer-item" href="/most-viewed/">Most Viewed</a>
      <a class="drawer-item" href="/random/">Random</a>
      <a class="drawer-item" href="/tags/">All tags</a>
    </div>
  </div>
  <div class="drawer-bottom">
    <a class="drawer-item" href="/admin/">Admin</a>
  </div>
</nav>

<main>
{% if not hideAds %}
<!-- AD SLOT: mid-page — paste a safe ad network's code here when ready -->
<div id="ad-slot-mid" style="min-height:0;"></div>
<script src="https://pl30631749.effectivecpmnetwork.com/c1/7c/85/c17c85d6647552e8a97a0a472fdef602.js"></script>
{% endif %}

{{ content | safe }}

{% if not hideAds %}
<!-- AD SLOT: end-of-page — paste a safe ad network's code here when ready -->
<div id="ad-slot-bottom" style="min-height:0;"></div>
<script async src="https://js.mbidadm.com/static/scripts.js" data-admpid="451070"></script>
{% endif %}
</main>

{% if not hideAds %}
<div id="ad-native-banner" style="padding:10px 14px;"></div>
<script async="async" data-cfasync="false" src="https://pl30631751.effectivecpmnetwork.com/50221255d787b85fefeab7dbc49aa3ef/invoke.js"></script>
<div id="container-50221255d787b85fefeab7dbc49aa3ef"></div>
{% endif %}

{% if not hideAds %}
<div class="vpn-overlay" id="vpn-overlay">
  <div class="vpn-modal">
    <h2 class="vpn-title">CONNECT <span>VPN</span></h2>
    <p class="vpn-text">If any video was not playing, please connect VPN and it will start playing properly.</p>
    <button class="vpn-ok" id="vpn-ok-btn">OK</button>
  </div>
</div>
{% endif %}

<footer class="site-footer">
  <span>© {{ year }} LinksZane</span>
</footer>

<script>
  var menuBtn = document.getElementById('menu-btn');
  var drawer = document.getElementById('drawer');
  var overlay = document.getElementById('drawer-overlay');
  var closeBtn = document.getElementById('drawer-close');
  var catToggle = document.getElementById('cat-toggle');
  var catSub = document.getElementById('cat-sub');
  var catChevron = document.getElementById('cat-chevron');
  function openDrawer(){ drawer.classList.add('open'); overlay.classList.add('open'); }
  function closeDrawer(){ drawer.classList.remove('open'); overlay.classList.remove('open'); }
  menuBtn.addEventListener('click', openDrawer);
  closeBtn.addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);
  catToggle.addEventListener('click', function(){
    catSub.classList.toggle('open');
    catChevron.classList.toggle('rot');
  });

  var vpnOverlay = document.getElementById('vpn-overlay');
  if (vpnOverlay) {
    var shown = false;
    try { shown = sessionStorage.getItem('vpnBannerShown') === '1'; } catch(e) {}
    if (!shown) {
      vpnOverlay.classList.add('open');
      try { sessionStorage.setItem('vpnBannerShown', '1'); } catch(e) {}
      var hideVpn = function(){ vpnOverlay.classList.remove('open'); };
      document.getElementById('vpn-ok-btn').addEventListener('click', hideVpn);
      setTimeout(hideVpn, 5000);
    } else {
      vpnOverlay.remove();
    }
  }
</script>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
(function(){
  var cards = document.querySelectorAll('[data-vid]');
  if (!cards.length) return;
  var SUPABASE_URL = "https://owuchppfijermqpuggfh.supabase.co";
  var SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im93dWNocHBmaWplcm1xcHVnZ2ZoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIxOTgzNDMsImV4cCI6MjA5Nzc3NDM0M30._sp1ITPTxTjghaZLEGlxZCV203XNxVjWA4nirYMN_iU";
  var supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
    auth: { persistSession: false, autoRefreshToken: false }
  });
  var ids = Array.prototype.map.call(cards, function(el){ return el.getAttribute('data-vid'); });
  supabase.from('linkszane_videos').select('id, views').in('id', ids).then(function(res){
    if (res.error || !res.data) return;
    var map = {};
    res.data.forEach(function(row){ map[row.id] = row.views || 0; });
    cards.forEach(function(el){
      var id = el.getAttribute('data-vid');
      if (map.hasOwnProperty(id)) el.textContent = map[id];
    });
  }).catch(function(){});
})();
</script>
</body>
</html>
